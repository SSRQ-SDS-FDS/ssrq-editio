{# def
    request: Request
#}

{% do attrs.add_class("cover-banner") %}

<section {{ attrs.render() }} >
    <div class="cover-image">
        <img src="{{ url_for('static', path='images/cover_image.jpg') }}"
             class="cover-image"
             alt="Cover Image" />
    </div>
    <div class="cover-overlay" />
    <div class="cover-content flex items-center justify-center">
        <div class="w-full flex flex-col items-center">
            <div class="w-full max-w-5xl px-8 sm:px-12 lg:px-20 page-title">{{ content }}</div>
        </div>
    </div>
</section>
